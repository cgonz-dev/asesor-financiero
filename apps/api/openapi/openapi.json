                "type": "string"
              },
              "expiresAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              "id": {
                "description": "Opaque Household invitation identifier; it is not the invitation secret.",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "expired",
                  "revoked",
                  "accepted"
                ],
                "type": "string"
              },
              "targetEmailHint": {
                "description": "Redacted delivery hint visible only to the authorized Owner.",
                "maxLength": 320,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "createdAt",
              "expiresAt",
              "id",
              "status",
              "targetEmailHint"
            ],
            "type": "object"
          },
          "invitationToken": {
            "description": "Single-use opaque invitation secret submitted only in a POST body.",
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "invitation",
          "invitationToken"
        ],
        "type": "object"
      },
