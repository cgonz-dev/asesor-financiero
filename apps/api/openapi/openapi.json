{
  "components": {
    "schemas": {
      "AuthenticationErrorDto": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AUTHENTICATION_REQUIRED",
              "AUTHENTICATION_INVALID"
            ],
            "type": "string"
          },
          "message": {
            "description": "Safe, localizable public message.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "copiloto-financiero-api",
            "description": "Stable service identifier.",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "description": "The API process is healthy.",
            "type": "string"
          },
          "version": {
            "description": "Application version reported by the service.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "type": "object"
      },
      "MeResponseDto": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Opaque internal User identifier.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "status": {
            "description": "Current internal User status.",
            "enum": [
              "active",
              "blocked"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "ReadinessResponseDto": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "copiloto-financiero-api",
            "description": "Stable service identifier.",
            "type": "string"
          },
          "status": {
            "description": "Whether the API can serve requests that depend on its infrastructure.",
            "enum": [
              "ready",
              "notReady"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "auth0": {
        "bearerFormat": "JWT",
        "description": "Auth0 access token issued for the Copiloto Financiero API audience.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "API contracts implemented so far. It contains no financial operations.",
    "title": "Copiloto Financiero API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "copiloto-financiero-api",
                  "status": "ok",
                  "version": "0.1.0"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            },
            "description": "The API process is healthy."
          }
        },
        "summary": "Report API process health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "status": "active"
                },
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            },
            "description": "The access token maps to an active internal User."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "code": "AUTHENTICATION_REQUIRED",
                  "message": "Se requiere una sesión válida."
                },
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationErrorDto"
                }
              }
            },
            "description": "A valid access token for this API is required."
          }
        },
        "security": [
          {
            "auth0": []
          }
        ],
        "summary": "Return the minimal authenticated internal User profile",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/readiness": {
      "get": {
        "operationId": "ReadinessController_getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "copiloto-financiero-api",
                  "status": "ready"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": "The API can use its required infrastructure."
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "service": "copiloto-financiero-api",
                  "status": "notReady"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": "The API cannot currently use its required infrastructure."
          }
        },
        "summary": "Report whether the API can use its required infrastructure",
        "tags": [
          "readiness"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
