  "info": {
    "contact": {},
    "description": "API contracts implemented so far. It contains no financial operations.",
    "title": "Copiloto Financiero API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "copiloto-financiero-api",
                  "status": "ok",
                  "version": "0.1.0"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            },
            "description": "The API process is healthy."
          }
        },
        "summary": "Report API process health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/households": {
      "get": {
        "operationId": "HouseholdsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "households": [
                    {
                      "id": "22222222-2222-4222-8222-222222222222",
                      "membershipStatus": "active",
                      "name": "Hogar de prueba",
                      "role": "owner"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ListHouseholdsResponseDto"
                }
              }
            },
            "description": "Only active memberships for the authenticated User are returned."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "code": "AUTHENTICATION_REQUIRED",
                  "message": "Se requiere una sesión válida."
                },
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationErrorDto"
                }
              }
            },
            "description": "A valid access token for this API is required."
          }
        },
        "security": [
          {
            "auth0": []
          }
        ],
        "summary": "List active Households for the authenticated User",
        "tags": [
          "households"
        ]
      },
      "post": {
        "operationId": "HouseholdsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHouseholdRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "id": "22222222-2222-4222-8222-222222222222",
                  "membershipStatus": "active",
                  "name": "Hogar de prueba",
                  "role": "owner"
                },
                "schema": {
                  "$ref": "#/components/schemas/HouseholdDetailDto"
                }
              }
            },
            "description": "The Household and its single initial Owner Active membership were created."
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "code": "HOUSEHOLD_VALIDATION_FAILED",
                  "message": "Revisa los datos del hogar."
                },
                "schema": {
                  "$ref": "#/components/schemas/HouseholdErrorDto"
                }
              }
            },
            "description": "The request body does not satisfy the shared Household contract."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "code": "AUTHENTICATION_REQUIRED",
                  "message": "Se requiere una sesión válida."
                },
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationErrorDto"
                }
              }
            },
            "description": "A valid access token for this API is required."
          }
        },
        "security": [
          {
            "auth0": []
          }
        ],
        "summary": "Create a Household with the authenticated User as Owner Active",
        "tags": [
          "households"
        ]
      }
    },
    "/api/v1/households/{householdId}": {
      "get": {
        "operationId": "HouseholdsController_get",
        "parameters": [
          {
            "in": "path",
            "name": "householdId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "id": "22222222-2222-4222-8222-222222222222",
                  "membershipStatus": "active",
                  "name": "Hogar de prueba",
                  "role": "owner"
                },
                "schema": {
                  "$ref": "#/components/schemas/HouseholdDetailDto"
                }
              }
            },
            "description": "The authenticated User has an active membership in the Household."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "code": "AUTHENTICATION_REQUIRED",
                  "message": "Se requiere una sesión válida."
                },
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationErrorDto"
                }
              }
            },
            "description": "A valid access token for this API is required."
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "code": "HOUSEHOLD_NOT_FOUND",
                  "message": "El hogar no existe o no está disponible."
                },
                "schema": {
                  "$ref": "#/components/schemas/HouseholdErrorDto"
                }
              }
            },
            "description": "The Household does not exist or is not visible to the authenticated User."
          }
        },
        "security": [
          {
            "auth0": []
          }
        ],
        "summary": "Get an authorized Household basic profile",
        "tags": [
          "households"
        ]
      }
    },
    "/api/v1/households/{householdId}/invitations": {
      "get": {
        "operationId": "HouseholdInvitationsController_list",
        "parameters": [
          {
            "in": "path",
            "name": "householdId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "invitations": [
                    {
                      "createdAt": "2026-08-25T18:00:00.000Z",
                      "expiresAt": "2026-09-01T18:00:00.000Z",
                      "id": "33333333-3333-4333-8333-333333333333",
                      "status": "pending",
                      "targetEmailHint": "p***@example.test"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ListHouseholdInvitationsResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "code": "AUTHENTICATION_REQUIRED",
                  "message": "Se requiere una sesión válida."
                },
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationErrorDto"
                }
              }
