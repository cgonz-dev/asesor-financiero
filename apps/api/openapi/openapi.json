{
  "components": {
    "schemas": {
      "AcceptHouseholdInvitationRequestDto": {
        "additionalProperties": false,
        "properties": {
          "invitationToken": {
            "description": "Single-use opaque invitation secret submitted only in a POST body.",
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "invitationToken"
        ],
        "type": "object"
      },
      "AcceptHouseholdInvitationResponseDto": {
        "additionalProperties": false,
        "properties": {
          "household": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Opaque Household identifier.",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "membershipStatus": {
                "const": "active",
                "type": "string"
              },
              "name": {
                "description": "Human-readable Household name.",
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "enum": [
                  "owner",
                  "member"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "membershipStatus",
              "name",
              "role"
            ],
            "type": "object"
          }
        },
        "required": [
          "household"
        ],
        "type": "object"
      },
      "AuthenticationErrorDto": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AUTHENTICATION_REQUIRED",
              "AUTHENTICATION_INVALID"
            ],
            "type": "string"
          },
          "message": {
            "description": "Safe, localizable public message.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "CreateHouseholdInvitationRequestDto": {
        "additionalProperties": false,
        "properties": {
          "targetEmail": {
            "description": "Normalized delivery restriction; it is not a User identifier.",
            "format": "email",
            "maxLength": 320,
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          }
        },
        "required": [
          "targetEmail"
        ],
        "type": "object"
      },
      "CreateHouseholdInvitationResponseDto": {
        "additionalProperties": false,
