{
  "name": "@copiloto/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "start": "expo start",
    "android": "expo start --android",
    "android:dev": "expo run:android --device",
    "android:build:cloud": "pnpm dlx eas-cli@22.4.0 build --platform android --profile development",
    "eas:env:set": "pnpm dlx eas-cli@22.4.0 env:set",
    "eas:init": "pnpm dlx eas-cli@22.4.0 init",
    "eas:login": "pnpm dlx eas-cli@22.4.0 login",
    "ios": "expo start --ios",
    "ios:dev": "expo run:ios --device",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@copiloto/contracts": "workspace:*",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-auth0": "5.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@copiloto/typescript-config": "workspace:*",
    "@types/react": "~19.2.2"
  }
}
