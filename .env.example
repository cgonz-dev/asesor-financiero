# Comma-separated browser origins allowed by the API. Keep this list explicit; do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional API bind host. `pnpm dev:lan` sets this only for its child API process.
API_HOST=

# Optional private IPv4 override for `pnpm dev:lan`; leave empty to autodetect.
LAN_IP=

# Required by the API and Prisma commands once Phase 2 persistence is used.
DATABASE_URL=

# Optional outside local migration development; never point it at DATABASE_URL.
SHADOW_DATABASE_URL=

# Directed Household invitations default to 168 hours (7 days). Development may override this
# with an integer from 1 through 720; expiration is always enforced server-side.
HOUSEHOLD_INVITATION_TTL_HOURS=168

# Web: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: use the development machine's LAN IP, for example http://192.0.2.10:3000
EXPO_PUBLIC_API_URL=

# Public Auth0 Native Application configuration. These values identify public resources;
# never place a client secret or Management API token in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_AUTH0_DOMAIN=your-development-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-public-native-application-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.copiloto-financiero.example

# Server-only allowlist for Auth0 access tokens. The issuer must use HTTPS and end in /.
AUTH0_ISSUER=https://your-development-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.copiloto-financiero.example
