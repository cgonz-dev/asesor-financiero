# Comma-separated browser origins allowed by the API. Keep this list explicit; do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional API bind host. `pnpm dev:lan` sets this only for its child API process.
API_HOST=

# Optional private IPv4 override for `pnpm dev:lan`; leave empty to autodetect.
LAN_IP=

# Required by the API and Prisma commands once Phase 2 persistence is used.
DATABASE_URL=

# Optional outside local migration development; never point it at DATABASE_URL.
SHADOW_DATABASE_URL=

# Web: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: use the development machine's LAN IP, for example http://192.0.2.10:3000
EXPO_PUBLIC_API_URL=
