{
  "name": "copiloto-financiero",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Copiloto Financiero",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/domain build && pnpm --parallel --filter @copiloto/api --filter @copiloto/mobile dev",
    "dev:api": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/domain build && pnpm --filter @copiloto/api dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:mobile": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/mobile dev",
    "dev:mobile:native": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/mobile dev:client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm db:generate && vitest run",
    "test:unit": "pnpm db:generate && vitest run --config vitest.unit.config.ts",
    "test:integration": "pnpm db:generate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm db:generate && vitest run --config vitest.e2e.config.ts",
    "build": "pnpm -r --if-present build",
    "db:dev": "pnpm --filter @copiloto/api exec prisma dev --name copiloto-financiero --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:dev:stop": "pnpm --filter @copiloto/api exec prisma dev stop copiloto-financiero",
    "db:generate": "pnpm --filter @copiloto/api exec prisma generate",
    "db:migrate": "pnpm --filter @copiloto/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @copiloto/api exec prisma migrate deploy",
    "db:status": "pnpm --filter @copiloto/api exec prisma migrate status",
    "db:studio": "pnpm --filter @copiloto/api exec prisma studio",
    "openapi:generate": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/domain build && pnpm --filter @copiloto/api openapi:generate",
    "openapi:check": "pnpm --filter @copiloto/contracts build && pnpm --filter @copiloto/domain build && pnpm --filter @copiloto/api openapi:check"
  },
  "devDependencies": {
    "@copiloto/eslint-config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
